{
  "name": "@cocasts/agent-config-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/cli build",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bun run check && bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
